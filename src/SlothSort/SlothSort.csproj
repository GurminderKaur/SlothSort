<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>slothsort</AssemblyName>
    <RootNamespace>SlothSort</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- One offline HTML page embedded in the executable. No NuGet packages, no CDNs. -->
  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="index.html" />
  </ItemGroup>

</Project>
